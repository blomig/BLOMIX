"guide.title" = "Guide";
"guide.replay_tutorial" = "Replay tutorial";
"guide.section.blox.title" = "Blox and chains";
"guide.section.blox.body" = "8×8 grid, gravity toward the top.\nA chain: 5 or more blox of the same colour in contact, including diagonally.";
"guide.section.brix.title" = "Brix";
"guide.section.brix.body" = "Numbered blocks. An adjacent chain knocks 1 off (once per wave).\nAt 0 they vanish: +20 pts.";
"guide.section.line.title" = "Incoming line";
"guide.section.line.body" = "Every 10 placed blox / Brix (every 5 in Five), a random row rises from the bottom.\nUsing a bomb is not a move: the LINE counter does not advance.";
"guide.section.bombs.title" = "Bombs";
"guide.section.bombs.body" = "Stock: 5 in Arcade/Zen/Five, 3 in Duel.\nZen, Five, Duel and tutorial: a 3×3 blast zone.\nArcade: 3×3 at Stage 1, then a cross that lengthens each Stage.";
"guide.section.magix.title" = "Magix";
"guide.section.magix.intro" = "Special blocks with powerful effects, very rare, and they only appear in Arcade, Zen or Five in the blox / Brix launch queue.";
"guide.section.magix.body" = "CHROMAX (?) — random coloured path on impact, more or less long.\nBRIXED (9) — becomes Brix(9); all other Brix are destroyed (+20).\nCROSSX (+) — row + column repainted one colour, then chains.\nSLASHX (X) — diagonals repainted one colour, then chains.\nSCRUMBLX (=) — each row shifts a random number of cells; −1 on every Brix.\nCOLORX (O) — clears all blox of a random colour.\nSAINTX (∞) — clears the board, leaves a Brix; +200 × stage.\nTWISTX (§) — swaps one blox colour for the lowest Brix.\nBOMBX (B) — random colour stain, then adds a bomb to the stock.";
"guide.section.score.title" = "Score";
"guide.section.score.body" = "Chains: 5 points for a chain of 5 blox, up to 20 for a very long chain. +10 for a cascade chain.\nCleared column: +10. Fully empty board: +500 (Arcade/Zen/Five, no stage multiplier).";
"guide.section.duel.title" = "Duel";
"guide.section.duel.body" = "The big number and the bar are the attack meter (0…50): every 50 points sends a line to the other player.\nPlacing a bomb freezes your turn timer.";
"guide.section.five.title" = "Five";
"guide.section.five.body" = "No timer and no stages, like Zen, but a line every 5 placed blox / Brix (bombs don’t count).\nMagix yes. 3×3 bombs, stock of 5. LINE HUD x/5.\n+500 empty board and SAINTX +200, no stage multiplier. FiveMode leaderboard.";

