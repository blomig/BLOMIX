"guide.title" = "Guia";
"guide.replay_tutorial" = "Rever o tutorial";
"guide.section.blox.title" = "Blox e cadeias";
"guide.section.blox.body" = "Grade 8×8, gravidade para cima.\nUma cadeia: 5 ou mais blox da mesma cor em contato, inclusive na diagonal.";
"guide.section.brix.title" = "Brix";
"guide.section.brix.body" = "Blocos numerados. Uma cadeia adjacente tira 1 (uma vez por onda).\nEm 0 eles somem: +20 pts.";
"guide.section.line.title" = "Linha entrante";
"guide.section.line.body" = "A cada 10 blox / Brix colocados, uma fileira aleatória sobe de baixo.\nUsar uma bomba não é um lance: o contador LINHA não avança.";
"guide.section.bombs.title" = "Bombas";
"guide.section.bombs.body" = "Estoque: 5 no Arcade/Zen, 3 no Duelo.\nZen, Duelo e tutorial: explosão 3×3.\nArcade: 3×3 no Stage 1, depois uma cruz que alonga a cada Stage.";
"guide.section.magix.title" = "Magix";
"guide.section.magix.intro" = "Blocos especiais com efeitos fortes, bem raros, e só aparecem no Arcade ou no Zen na fila de blox / Brix a lançar.";
"guide.section.magix.body" = "CHROMAX (?) — caminho colorido aleatório no impacto, mais ou menos longo.\nBRIXED (9) — vira Brix(9); todos os outros Brix são destruídos (+20).\nCROSSX (+) — linha + coluna pintadas de uma cor, depois cadeias.\nSLASHX (X) — diagonais pintadas de uma cor, depois cadeias.\nSCRUMBLX (=) — cada linha desliza um número aleatório de casas; −1 em todos os Brix.\nCOLORX (O) — limpa todos os blox de uma cor aleatória.\nSAINTX (∞) — esvazia a grade, deixa um Brix; +200 × stage.\nTWISTX (§) — troca uma cor de blox pelo Brix mais baixo.\nBOMBX (B) — mancha de cor aleatória, depois adiciona uma bomba ao estoque.";
"guide.section.score.title" = "Pontuação";
"guide.section.score.body" = "Cadeias: 5 pontos para uma cadeia de 5 blox, até 20 para uma bem longa. +10 para uma cadeia em cascata.\nColuna esvaziada: +10. Grade totalmente vazia: +500 (Arcade/Zen, sem multiplicador de stage).";
"guide.section.duel.title" = "Duelo";
"guide.section.duel.body" = "O número grande e a barra são o medidor de ataque (0…50): a cada 50 pontos, uma linha vai para o outro jogador.\nColocar uma bomba congela o timer do seu turno.";

