# frozen_string_literal: true

# Pipeline App Store Connect BLOMIX.
# Source de verite textes : store/whats-new/, promotional-text/, name/, subtitle/
# (jamais fastlane/metadata versionne -- trop facile d'ecraser description / captures).

opt_out_usage
skip_docs

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
# agvtool / archive exigent Xcode.app, pas /Library/Developer/CommandLineTools.
ENV["DEVELOPER_DIR"] ||= "/Applications/Xcode.app/Contents/Developer"
XCODEPROJ = File.join(ROOT, "Blomix/Blomix.xcodeproj")
SCHEME = "Blomix"
BUNDLE_ID = "blomig.BLOMIX"
TEAM_ID = "337CZP5VR7"
LOCALES = %w[en-US fr-FR de-DE es-ES it-IT pt-BR].freeze
# deliver n'accepte pas it-IT (dossier = "it"). store/ garde it-IT.txt.
FASTLANE_LOCALE = {
  "en-US" => "en-US",
  "fr-FR" => "fr-FR",
  "de-DE" => "de-DE",
  "es-ES" => "es-ES",
  "it-IT" => "it",
  "pt-BR" => "pt-BR"
}.freeze
GENERATED_METADATA = File.join(ROOT, "fastlane/metadata/.generated")

platform :ios do
  before_all do
    load_root_env!
  end

  desc "Valide store/ (6 langues) + entitlements Release=production"
  lane :validate do
    validate_project!(require_store: true)
  end

  desc "Pousse Nouveautés + texte promo (6 locales). Ne touche pas description/captures."
  lane :metadata do
    validate_project!(require_store: true)
    generated = generate_deliver_metadata!
    if dry_run?
      UI.success("DRY_RUN : metadonnees generees dans #{generated} -- rien envoye a ASC")
      next
    end
    api = connect_api_key!
    version = marketing_version
    assert_editable_version_is_ours!(version)
    UI.message("Version ASC visée : #{version}")
    upload_to_app_store(
      **deliver_common(api, version).merge(
        skip_binary_upload: true,
        metadata_path: generated,
        skip_metadata: false,
        submit_for_review: false,
        edit_live: edit_live?
      )
    )
  end

  desc "Archive Release + upload TestFlight (pas de fiche magasin, pas de review)"
  lane :beta do
    validate_project!(require_store: false)
    api = connect_api_key!
    bump_build_number!(api)
    ipa = archive_release_ipa!
    upload_to_testflight(
      api_key: api,
      ipa: ipa,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: skip_wait?,
      distribute_external: false,
      changelog: testflight_changelog,
      uses_non_exempt_encryption: false
    )
  end

  desc "Archive + upload binaire + Nouveautés/promo. Ne soumet PAS à la review."
  lane :release do
    validate_project!(require_store: true)
    api = connect_api_key!
    assert_editable_version_is_ours!(marketing_version)
    bump_build_number!(api)
    ipa = archive_release_ipa!
    generated = generate_deliver_metadata!
    upload_to_app_store(
      **deliver_common(api, marketing_version).merge(
        ipa: ipa,
        skip_binary_upload: false,
        metadata_path: generated,
        skip_metadata: false,
        submit_for_review: false
      )
    )
    UI.success("Build #{iphone_build_number} uploadé pour #{marketing_version}.")
    UI.important("Review non lancee. Quand le build est Valid dans ASC : bundle exec fastlane submit")
  end

  desc "Soumet la version MARKETING_VERSION à la review (build déjà uploadé). Irréversible."
  lane :submit do
    validate_project!(require_store: true)
    api = connect_api_key!
    generated = generate_deliver_metadata!
    version = marketing_version
    build = iphone_build_number
    assert_editable_version_is_ours!(version)
    UI.important("Soumission #{version} (build #{build}) -- automatic_release=true")
    upload_to_app_store(
      **deliver_common(api, version).merge(
        skip_binary_upload: true,
        build_number: build,
        metadata_path: generated,
        skip_metadata: false,
        submit_for_review: true,
        automatic_release: true,
        submission_information: {
          add_id_info_uses_idfa: false,
          export_compliance_uses_encryption: false,
          export_compliance_encryption_updated: false
        }
      )
    )
  end
end

###############################################################################
# Helpers
###############################################################################

def load_root_env!
  [File.join(ROOT, ".env"), File.join(ROOT, "fastlane/.env")].each do |path|
    next unless File.exist?(path)

    File.readlines(path, chomp: true).each do |line|
      next if line.empty? || line.start_with?("#")
      next unless line.include?("=")

      key, val = line.split("=", 2)
      key = key.strip
      val = val.strip.sub(/\A["']/, "").sub(/["']\z/, "")
      ENV[key] = val if ENV[key].to_s.empty?
    end
  end
end

def dry_run?
  truthy?(ENV["DRY_RUN"])
end

def skip_wait?
  truthy?(ENV["SKIP_WAIT"])
end

def edit_live?
  truthy?(ENV["EDIT_LIVE"])
end

def truthy?(value)
  %w[1 true yes].include?(value.to_s.strip.downcase)
end

def validate_project!(require_store:)
  args = ["ruby", File.join(ROOT, "scripts/validate-store-metadata.rb")]
  args << "--skip-store" unless require_store
  Dir.chdir(ROOT) do
    system(*args) or UI.user_error!("Validation store/ ou entitlements echouee")
  end
end

def connect_api_key!
  key_id = ENV["ASC_KEY_ID"].to_s.strip
  issuer = ENV["ASC_ISSUER_ID"].to_s.strip
  key_path = File.expand_path(ENV["ASC_KEY_PATH"].to_s.strip)
  missing = []
  missing << "ASC_KEY_ID" if key_id.empty?
  missing << "ASC_ISSUER_ID" if issuer.empty?
  missing << "ASC_KEY_PATH (fichier .p8)" if key_path.empty? || !File.file?(key_path)
  unless missing.empty?
    UI.user_error!(
      "Clé API App Store Connect manquante : #{missing.join(', ')}.\n" \
      "1. ASC → Users and Access → Integrations → App Store Connect API → Team Key (App Manager)\n" \
      "2. cp .env.example .env  puis remplir ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH\n" \
      "3. Le .p8 reste HORS git (ex. ~/.appstoreconnect/AuthKey_….p8)"
    )
  end
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer,
    key_filepath: key_path,
    in_house: false,
    duration: 1200,
    set_spaceship_token: true
  )
end

# Cible iPhone (`Blomix/Info.plist`). La Watch peut rester en 8.0 / 146.
def iphone_pbx_setting(key)
  pbx = File.read(File.join(XCODEPROJ, "project.pbxproj"))
  values = []
  pbx.split("isa = XCBuildConfiguration;").each do |block|
    next unless block.include?("INFOPLIST_FILE = Blomix/Info.plist")

    val = block[/#{Regexp.escape(key)} = ([^;]+);/, 1]
    values << val.strip if val
  end
  values.uniq
end

def marketing_version
  versions = iphone_pbx_setting("MARKETING_VERSION")
  UI.user_error!("MARKETING_VERSION iPhone introuvable dans le pbxproj") if versions.empty?
  UI.user_error!("MARKETING_VERSION iPhone incohérent : #{versions.join(', ')}") if versions.size > 1
  versions.first
end

def iphone_build_number
  builds = iphone_pbx_setting("CURRENT_PROJECT_VERSION")
  UI.user_error!("CURRENT_PROJECT_VERSION iPhone introuvable") if builds.empty?
  UI.user_error!("CURRENT_PROJECT_VERSION iPhone incohérent : #{builds.join(', ')}") if builds.size > 1
  builds.first
end

def set_iphone_build_number!(nxt)
  path = File.join(XCODEPROJ, "project.pbxproj")
  pbx = File.read(path)
  updated = pbx.split("isa = XCBuildConfiguration;").map.with_index do |block, idx|
    next block if idx.zero?
    next block unless block.include?("INFOPLIST_FILE = Blomix/Info.plist")

    block.sub(/CURRENT_PROJECT_VERSION = [^;]+;/, "CURRENT_PROJECT_VERSION = #{nxt};")
  end
  File.write(path, updated.join("isa = XCBuildConfiguration;"))
end

# deliver(skip_app_version_update: false) renomme la version éditable ASC
# au lieu d'en créer une à côté (6.9 vendue avec le binaire 6.8 / 128).
def assert_editable_version_is_ours!(intended)
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("App #{BUNDLE_ID} introuvable sur ASC") unless app

  blocking = %w[
    PREPARE_FOR_SUBMISSION
    WAITING_FOR_REVIEW
    IN_REVIEW
    PENDING_DEVELOPER_RELEASE
    PENDING_APPLE_RELEASE
    DEVELOPER_REJECTED
    REJECTED
    METADATA_REJECTED
    INVALID_BINARY
  ]
  app.get_app_store_versions(filter: { platform: "IOS" }, limit: 8).each do |v|
    state = v.app_store_state.to_s
    next unless blocking.include?(state)
    next if v.version_string.to_s == intended.to_s

    UI.user_error!(
      "ASC a déjà #{v.version_string} en #{state}. " \
      "`release`/`submit`/`metadata` avec app_version=#{intended} " \
      "renommerait cette fiche sans attacher le nouveau binaire " \
      "(incident 6.9 / build 128). Attendre READY_FOR_SALE, ou retirer la version dans ASC."
    )
  end
end

def bump_build_number!(api)
  local = iphone_build_number.to_i
  remote = 0
  begin
    tf = latest_testflight_build_number(
      api_key: api,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    ).to_i
    live = begin
      app_store_build_number(
        api_key: api,
        app_identifier: BUNDLE_ID,
        live: true,
        initial_build_number: 0
      ).to_i
    rescue StandardError
      0
    end
    remote = [tf, live].max
    UI.message("Build local #{local} -- TestFlight/ASC max #{remote}")
  rescue StandardError => e
    UI.user_error!(
      "Impossible de lire le dernier build ASC (#{e.message}). " \
      "Impossible de bumper le build sans ASC. Corriger la cle API."
    )
  end
  nxt = [local, remote + 1].max
  if nxt == local
    UI.success("Build #{local} encore libre -- on le garde.")
  else
    set_iphone_build_number!(nxt)
    UI.success("CURRENT_PROJECT_VERSION iPhone → #{nxt} (Watch inchangée ; committer le pbxproj)")
  end
  nxt
end

def archive_release_ipa!
  clean = ENV["CLEAN"].to_s != "0"
  build_app(
    project: XCODEPROJ,
    scheme: SCHEME,
    configuration: "Release",
    clean: clean,
    export_method: "app-store",
    export_team_id: TEAM_ID,
    output_directory: File.join(ROOT, "build"),
    output_name: "BLOMIX",
    include_bitcode: false,
    include_symbols: true,
    destination: "generic/platform=iOS",
    xcargs: "-allowProvisioningUpdates",
    export_options: {
      method: "app-store",
      signingStyle: "automatic",
      teamID: TEAM_ID,
      uploadSymbols: true,
      compileBitcode: false
    }
  )
  ipa = File.join(ROOT, "build/BLOMIX.ipa")
  UI.user_error!("IPA introuvable : #{ipa}") unless File.file?(ipa)
  ipa
end

def generate_deliver_metadata!
  FileUtils.rm_rf(GENERATED_METADATA)
  LOCALES.each do |locale|
    dir = File.join(GENERATED_METADATA, FASTLANE_LOCALE.fetch(locale))
    FileUtils.mkdir_p(dir)
    notes = File.read(File.join(ROOT, "store/whats-new/#{locale}.txt"), encoding: "UTF-8")
    promo = File.read(File.join(ROOT, "store/promotional-text/#{locale}.txt"), encoding: "UTF-8")
    name = File.read(File.join(ROOT, "store/name/#{locale}.txt"), encoding: "UTF-8")
    subtitle = File.read(File.join(ROOT, "store/subtitle/#{locale}.txt"), encoding: "UTF-8")
    File.write(File.join(dir, "release_notes.txt"), notes.gsub("\r\n", "\n").strip + "\n")
    File.write(File.join(dir, "promotional_text.txt"), promo.gsub("\r\n", "\n").strip + "\n")
    File.write(File.join(dir, "name.txt"), name.gsub("\r\n", "\n").strip + "\n")
    File.write(File.join(dir, "subtitle.txt"), subtitle.gsub("\r\n", "\n").strip + "\n")
    # Description / mots-clés : seulement si store/ en a (nouvelle locale, ex. pt-BR).
    # Absent = deliver ne touche pas le champ ASC existant.
    desc_src = File.join(ROOT, "store/description/#{locale}.txt")
    if File.file?(desc_src)
      File.write(
        File.join(dir, "description.txt"),
        File.read(desc_src, encoding: "UTF-8").gsub("\r\n", "\n").strip + "\n"
      )
    end
    kw_src = File.join(ROOT, "store/keywords/#{locale}.txt")
    if File.file?(kw_src)
      File.write(
        File.join(dir, "keywords.txt"),
        File.read(kw_src, encoding: "UTF-8").gsub("\r\n", "\n").strip + "\n"
      )
    end
  end
  UI.message("Métadonnées générées (Nouveautés + promo + nom + sous-titre) → #{GENERATED_METADATA}")
  GENERATED_METADATA
end

def testflight_changelog
  path = File.join(ROOT, "store/whats-new/en-US.txt")
  return nil unless File.file?(path)

  File.read(path, encoding: "UTF-8").gsub("\r\n", "\n").strip
end

def deliver_common(api, version)
  {
    api_key: api,
    app_identifier: BUNDLE_ID,
    app_version: version,
    skip_screenshots: true,
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
    reject_if_possible: false,
    overwrite_screenshots: false,
    version_check_wait_retry_limit: 10
  }
end
