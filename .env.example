# Copier vers .env à la racine (gitignoré) et remplir.
# App Store Connect → Users and Access → Integrations → App Store Connect API
# Créer une Team Key, rôle App Manager (Admin si signature automatique + profils).

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Optionnel : identifiant numérique de l’app (sinon Fastlane résout blomig.BLOMIX)
# ASC_APP_ID=

# Optionnel
# SKIP_WAIT=1    # ne pas attendre la fin du processing TestFlight
# CLEAN=0        # pas de clean xcodebuild (plus rapide, moins reproductible)
# EDIT_LIVE=1    # metadata : écrire le texte promo sur la version en vente
# DRY_RUN=1      # metadata : générer et afficher, sans upload ASC
