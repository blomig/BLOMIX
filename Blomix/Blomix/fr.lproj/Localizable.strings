"guide.title" = "Guide";
"guide.replay_tutorial" = "Rejouer le tuto";
"guide.section.blox.title" = "Blox et chaînes";
"guide.section.blox.body" = "Grille 8×8, gravité vers le haut.\nUne chaîne : 5 blox ou plus de la même couleur en contact, y compris en diagonale.";
"guide.section.brix.title" = "Brix";
"guide.section.brix.body" = "Blocs numérotés. Une chaîne adjacente leur retire 1 (max une fois par vague).\nÀ 0 ils disparaissent : +20 pts.";
"guide.section.line.title" = "Ligne entrante";
"guide.section.line.body" = "Tous les 10 blox / Brix posés (tous les 5 en Five), une rangée aléatoire monte du bas.\nPoser une bombe n’est pas un coup : le compteur LIGNE n’avance pas.";
"guide.section.bombs.title" = "Bombes";
"guide.section.bombs.body" = "Stock : 5 en Arcade/Zen/Five, 3 en Duel.\nZen, Five, Duel et tuto : explosion d’une zone de 3×3.\nArcade : 3×3 au Stage 1, puis une croix qui s’allonge à chaque Stage.";
"guide.section.magix.title" = "Magix";
"guide.section.magix.intro" = "Des blocs spéciaux avec de gros pouvoirs, très rares, et qui n’apparaissent qu’en Arcade, Zen ou Five dans la file de blox / Brix à lancer.";
"guide.section.magix.body" = "CHROMAX (?) — chemin coloré aléatoire à l’impact, plus ou moins long.\nBRIXED (9) — devient Brix(9) ; tous les autres Brix sont détruits (+20).\nCROSSX (+) — ligne + colonne repeinte d’une couleur, puis chaînes.\nSLASHX (X) — diagonales repeintes d’une couleur, puis chaînes.\nSCRUMBLX (=) — chaque ligne glisse d’un nombre de cases aléatoires ; −1 sur tous les Brix.\nCOLORX (O) — efface tous les blox d’une couleur aléatoire.\nSAINTX (∞) — vide la grille, laisse un Brix ; +200 × stage.\nTWISTX (§) — échange une couleur de blox contre le Brix minimal.\nBOMBX (B) — tâche de couleur aléatoire, puis ajoute une bombe au stock.";
"guide.section.score.title" = "Score";
"guide.section.score.body" = "Chaînes : 5 points pour une chaîne de 5 blox, et jusqu’à 20 points pour une chaîne très longue. +10 pour une chaîne en cascade.\nColonne vidée : +10. Grille entièrement vide : +500 (Arcade/Zen/Five, hors ×stage).";
"guide.section.duel.title" = "Duel";
"guide.section.duel.body" = "Le gros chiffre et la barre sont le mètre d’attaque (0…50) : tous les 50 points, ça envoie une ligne à l’autre joueur.\nPlacer une bombe gèle votre timer de tour.";
"guide.section.five.title" = "Five";
"guide.section.five.body" = "Sans timer ni stages, comme Zen, mais une ligne tous les 5 blox / Brix posés (pas les bombes).\nMagix oui. Bombes 3×3, stock 5. HUD LIGNE x/5.\n+500 grille vide et SAINTX +200, sans ×stage. Classement FiveMode.";

